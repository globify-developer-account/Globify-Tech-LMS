# ─────────────────────────────────────────────────────────────
# Globify Tech — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-`openssl rand -base64 32`
AUTH_TRUST_HOST=true

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://globify:globify@localhost:5432/globify?schema=public

# Redis (optional — rate limiting + BullMQ queues; omit for in-process fallback)
REDIS_URL=

# Storage: local | s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=globify-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email: console | smtp | resend
EMAIL_DRIVER=console
EMAIL_FROM="Globify Tech <no-reply@globifytech.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# AI: openai | anthropic | google (provider abstraction — never hard-code one vendor)
AI_PROVIDER=anthropic
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Payments (comma-separated enabled providers: stripe,paypal,jazzcash,easypaisa,bank_transfer)
PAYMENT_PROVIDERS=bank_transfer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# WhatsApp (Meta Cloud API): console | meta
WHATSAPP_DRIVER=console
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS: console | twilio
SMS_DRIVER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Live classes: manual | zoom | google_meet | teams
LIVE_CLASS_DRIVER=manual
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backups
BACKUP_BUCKET=
BACKUP_HEARTBEAT_SECRET=
CRON_SECRET=

# Hermes integration API (/api/integration/v1) — see docs/INTEGRATION_API.md
# SHA-256 hex hashes of the accepted Hermes service keys, comma-separated so a
# key can be rotated with an overlap. Never the key itself. Empty = API off (501).
HERMES_INTEGRATION_KEY_HASHES=
