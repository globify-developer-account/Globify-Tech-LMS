# ─────────────────────────────────────────────────────────────
# Globify Tech — PRODUCTION TEMPLATE
# Copy these into your hosting provider's environment settings
# (or a server-side .env.production). Replace every <...> value.
# Do not set NODE_ENV here; the platform sets it.
# ─────────────────────────────────────────────────────────────

# Core
NEXT_PUBLIC_APP_URL=https://globifytech.com
AUTH_URL=https://globifytech.com
# Generate with: openssl rand -base64 32   (use a different value from development)
AUTH_SECRET=<32+ random characters>
AUTH_TRUST_HOST=true

# Database — managed PostgreSQL 15+ (Neon, Supabase, RDS, ...). Use SSL.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public&sslmode=require"

# Redis — recommended in production for rate limiting and BullMQ jobs
REDIS_URL=rediss://default:<password>@<host>:6379

# Storage: s3 (AWS S3, Cloudflare R2, Backblaze B2, ...)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=globifytech-media
S3_ACCESS_KEY_ID=<access key>
S3_SECRET_ACCESS_KEY=<secret key>
S3_PUBLIC_URL=https://media.globifytech.com

# Email: smtp | resend
EMAIL_DRIVER=resend
EMAIL_FROM="Globify Tech <no-reply@globifytech.com>"
RESEND_API_KEY=<re_...>
# If EMAIL_DRIVER=smtp instead:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI: openai | anthropic | google — only the selected provider's key is required
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=<sk-ant-...>
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Payments — comma-separated: stripe,paypal,jazzcash,easypaisa,bank_transfer
# Webhook URLs: https://globifytech.com/api/webhooks/{jazzcash,easypaisa,stripe,paypal}
PAYMENT_PROVIDERS=bank_transfer,jazzcash,easypaisa
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
JAZZCASH_MERCHANT_ID=<merchant id>
JAZZCASH_PASSWORD=<password>
JAZZCASH_INTEGRITY_SALT=<integrity salt>
EASYPAISA_STORE_ID=<store id>
EASYPAISA_HASH_KEY=<hash key>

# WhatsApp (Meta Cloud API): console | meta
# Webhook callback URL: https://globifytech.com/api/webhooks/whatsapp
WHATSAPP_DRIVER=meta
WHATSAPP_PHONE_NUMBER_ID=<phone number id>
WHATSAPP_ACCESS_TOKEN=<access token>
WHATSAPP_VERIFY_TOKEN=<random string you also enter in Meta>
WHATSAPP_APP_SECRET=<app secret>

# SMS: console | twilio
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=<AC...>
TWILIO_AUTH_TOKEN=<auth token>
TWILIO_FROM=<+1...>

# Live classes: manual | zoom | google_meet | teams
# Zoom event URL: https://globifytech.com/api/webhooks/zoom
LIVE_CLASS_DRIVER=zoom
ZOOM_ACCOUNT_ID=<account id>
ZOOM_CLIENT_ID=<client id>
ZOOM_CLIENT_SECRET=<client secret>
ZOOM_WEBHOOK_SECRET=<webhook secret>

# Google sign-in (optional)
# Authorised redirect URI: https://globifytech.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Observability
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=

# Backups and scheduled jobs — generate each with: openssl rand -hex 32
BACKUP_BUCKET=globifytech-backups
BACKUP_HEARTBEAT_SECRET=<random hex>
CRON_SECRET=<random hex>

# Hermes integration API (/api/integration/v1) — see docs/INTEGRATION_API.md
# SHA-256 hex hashes of the accepted Hermes service keys, comma-separated so a
# key can be rotated with an overlap. Never the key itself. Empty = API off (501).
HERMES_INTEGRATION_KEY_HASHES=
